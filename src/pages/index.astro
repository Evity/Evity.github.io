---
import FeaturedStory from "../components/FeaturedStory.astro";
import ListeningPanel from "../components/ListeningPanel.astro";
import StoryCard from "../components/StoryCard.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { categoryPath, categoryLabels, getLifePosts, lifeCategories } from "../lib/posts";

const lifePosts = await getLifePosts();
const featured = lifePosts.find((post) => post.data.featured) ?? lifePosts[0];
const stories = featured
  ? lifePosts.filter((post) => post.data.slug !== featured.data.slug).slice(0, 4)
  : lifePosts.slice(0, 4);
---

<SiteLayout
  title="认真生活，慢慢记录"
  description="吃过的味道、喜欢的歌，还有路上的风景。"
  activePath="/"
>
  <section class="home-intro" aria-labelledby="home-title">
    <p class="eyebrow">A PERSONAL JOURNAL</p>
    <div class="home-intro__row">
      <div>
        <h1 id="home-title"><span class="home-intro__headline-line">认真生活，</span><span class="home-intro__headline-line">慢慢记录。</span></h1>
        <p>吃过的味道、喜欢的歌，还有路上的风景。</p>
      </div>
      <p class="home-intro__topics">美食 / 咖啡 / 音乐 / 旅行</p>
    </div>
  </section>

  {featured && <FeaturedStory post={featured} />}

  <section class="home-journal" aria-labelledby="latest-heading">
    <div class="journal-main">
      <div class="section-heading">
        <h2 id="latest-heading">最新记录</h2>
        <a class="text-link" href="/life/">全部生活 <span aria-hidden="true">→</span></a>
      </div>
      {stories.length > 0 ? (
        <div class="story-grid">
          {stories.map((post) => <StoryCard post={post} headingLevel={3} />)}
        </div>
      ) : (
        <p class="empty-note">生活记录会从这里开始。</p>
      )}
    </div>
    <div class="journal-aside">
      <ListeningPanel />
      <nav class="life-categories" aria-label="生活主题">
        <h2>生活的几个切面</h2>
        <div class="life-categories__links">
          {lifeCategories.map((category) => (
            <a href={categoryPath(category)}>{categoryLabels[category]} <span aria-hidden="true">↗</span></a>
          ))}
        </div>
      </nav>
      <section class="home-about" aria-labelledby="home-about-heading">
        <h2 id="home-about-heading">关于这里</h2>
        <p>留下喜欢的味道与风景，偶尔回头看看日常。</p>
        <a class="text-link" href="/about/">认识一下 <span aria-hidden="true">→</span></a>
      </section>
    </div>
  </section>
</SiteLayout>
