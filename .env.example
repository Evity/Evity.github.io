# Existing Notion blog database. Keep credentials server-only.
NOTION_PAGE_ID=304744654b4b81689035f470b349cbd7
# Required for canonical links, sitemap and RSS on production. Use your real public URL.
NEXT_PUBLIC_SITE_URL=
# Existing NEXT_PUBLIC_LINK remains supported as a fallback.
# Optional for a database that requires authenticated access:
NOTION_TOKEN_V2=
NOTION_ACTIVE_USER=
# Keep old article paths stable. Empty string means no prefix.
NEXT_PUBLIC_POST_URL_PREFIX=article
