---
import { Picture } from "astro:assets";
import type { Post } from "../lib/posts";
import { categoryLabels, formatDate, postPath } from "../lib/posts";

interface Props {
  readonly post: Post;
}

const { post } = Astro.props;
---

<article class="featured-story">
  <div class:list={["featured-story__layout", { "featured-story__layout--text-only": !post.data.cover }]}>
    {post.data.cover && (
      <a class="featured-story__media" href={postPath(post)} aria-label={`打开文章：${post.data.title}`}>
        <Picture
          src={post.data.cover}
          alt={post.data.coverAlt ?? ""}
          formats={["avif", "webp"]}
          widths={[640, 960, 1200]}
          sizes="(min-width: 1280px) 672px, (min-width: 768px) 54vw, calc(100vw - 40px)"
          class="featured-story__image"
          loading="eager"
          fetchpriority="high"
        />
      </a>
    )}
    <div class="featured-story__copy">
      <p class="eyebrow">精选记录 / {categoryLabels[post.data.category]}</p>
      <h2 class="featured-story__title"><a href={postPath(post)}>{post.data.title}</a></h2>
      <p class="featured-story__description">{post.data.description}</p>
      <time class="featured-story__date" datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
      <a class="text-link" href={postPath(post)}>读这篇 <span aria-hidden="true">→</span></a>
    </div>
  </div>
</article>
