---
import { Picture } from "astro:assets";
import { render } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";
import StoryCard from "../../components/StoryCard.astro";
import { categoryLabels, codeTopicLabels, formatDate, getPublishedPosts, postPath } from "../../lib/posts";

export async function getStaticPaths() {
  return (await getPublishedPosts()).map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const categoryLabel = post.data.category === "code" && post.data.codeTopic
  ? codeTopicLabels[post.data.codeTopic]
  : categoryLabels[post.data.category];
const { Content, headings } = await render(post);
const related = (await getPublishedPosts())
  .filter((item) =>
    item.data.category === post.data.category &&
    item.data.slug !== post.data.slug &&
    post.data.tags.some((tag) => item.data.tags.includes(tag)),
  )
  .slice(0, 2);
---

<SiteLayout title={post.data.title} description={post.data.description} activePath={post.data.category === "code" ? "/code/" : "/life/"}>
  <article class="article-page">
    <header class="article-header">
      <a class="article-header__back" href={post.data.category === "code" ? "/code/" : "/life/"}>
        {post.data.category === "code" ? "代码" : "生活"} / {categoryLabel}
      </a>
      <h1>{post.data.title}</h1>
      <p class="article-header__description">{post.data.description}</p>
      <p class="article-header__date">
        <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
        {post.data.updatedDate && <span> · 更新于 {formatDate(post.data.updatedDate)}</span>}
        <span> · 示例文章</span>
      </p>
    </header>

    {post.data.cover && (
      <figure class="article-cover">
        <Picture
          src={post.data.cover}
          alt={post.data.coverAlt ?? ""}
          formats={["avif", "webp"]}
          widths={[720, 960, 1200, 1600]}
          sizes="(min-width: 1200px) 960px, calc(100vw - 40px)"
          class="article-cover__image"
          loading="eager"
        />
        {post.data.coverAlt && <figcaption>{post.data.coverAlt} · 示例摄影</figcaption>}
      </figure>
    )}

    <div class="article-layout">
      {headings.length > 0 && (
        <details class="article-toc" open>
          <summary>本文目录</summary>
          <nav aria-label="本文目录">
            {headings.filter((heading) => heading.depth <= 3).map((heading) => (
              <a href={`#${heading.slug}`} class:list={{ "article-toc__nested": heading.depth === 3 }}>{heading.text}</a>
            ))}
          </nav>
        </details>
      )}
      <div class="article-body"><Content /></div>
    </div>

    {post.data.gallery.length > 0 && (
      <section class="article-gallery" aria-label="文章照片">
        {post.data.gallery.map((photo) => (
          <figure>
            <Picture
              src={photo.src}
              alt={photo.alt}
              formats={["avif", "webp"]}
              widths={[480, 800, 1200]}
              sizes="(min-width: 900px) 440px, calc(100vw - 40px)"
              loading="lazy"
              decoding="async"
            />
            {photo.caption && <figcaption>{photo.caption} · 示例摄影</figcaption>}
          </figure>
        ))}
      </section>
    )}

    <div class="article-tags">
      {post.data.tags.map((tag) => <span>{tag}</span>)}
      <a class="text-link" href={postPath(post)}>回到文章顶部 <span aria-hidden="true">↑</span></a>
    </div>
    {related.length > 0 && (
      <section class="related-stories" aria-labelledby="related-heading">
        <h2 id="related-heading">同一主题</h2>
        <div class="story-grid story-grid--related">{related.map((item) => <StoryCard post={item} headingLevel={3} />)}</div>
      </section>
    )}
  </article>
  <script>
    for (const block of document.querySelectorAll<HTMLPreElement>(".article-body pre")) {
      const code = block.querySelector("code");
      if (!code) continue;

      const language = block.dataset.language ?? code.className.match(/language-([\w-]+)/)?.[1];
      const toolbar = document.createElement("div");
      const languageLabel = document.createElement("span");
      const button = document.createElement("button");
      const status = document.createElement("span");

      toolbar.className = "article-code-toolbar";
      languageLabel.textContent = language?.toUpperCase() ?? "代码片段";
      button.type = "button";
      button.textContent = "复制";
      button.setAttribute("aria-label", language ? `复制 ${language.toUpperCase()} 代码` : "复制代码");
      status.setAttribute("role", "status");
      status.setAttribute("aria-live", "polite");
      status.setAttribute("aria-atomic", "true");

      button.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(code.textContent ?? "");
          status.textContent = "已复制";
        } catch {
          status.textContent = "复制失败，请手动选择";
        }
      });

      toolbar.append(languageLabel, button, status);
      block.before(toolbar);
    }
  </script>
</SiteLayout>
