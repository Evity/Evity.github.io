---
import ArticleRow from "../components/ArticleRow.astro";
import Pagination from "../components/Pagination.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { categoryLabels, formatYear, getLifePosts, POSTS_PER_PAGE } from "../lib/posts";

const posts = await getLifePosts();
const pagePosts = posts.slice(0, POSTS_PER_PAGE);
const lastPage = Math.max(1, Math.ceil(posts.length / POSTS_PER_PAGE));
const years = [...new Set(pagePosts.map((post) => formatYear(post.data.pubDate)))];
---

<SiteLayout title="生活归档" description="按时间浏览美食、音乐、咖啡与旅行记录。" activePath="/archive/">
  <section class="archive-page" aria-labelledby="archive-title">
    <p class="eyebrow">LIFE ARCHIVE</p>
    <h1 id="archive-title">生活归档</h1>
    {posts.length > 0 ? (
      <div class="archive-years">
        {years.map((year) => (
          <section class="archive-year" aria-labelledby={`archive-${year}`}>
            <h2 id={`archive-${year}`}>{year}</h2>
            <ol class="archive-list">
              {pagePosts.filter((post) => formatYear(post.data.pubDate) === year).map((post) => (
                <li>
                  <ArticleRow post={post} label={categoryLabels[post.data.category]} headingLevel={3} />
                </li>
              ))}
            </ol>
          </section>
        ))}
      </div>
    ) : (
      <p class="empty-note">第一篇生活记录发布后，会出现在这里。</p>
    )}
    <Pagination currentPage={1} lastPage={lastPage} basePath="/archive/" />
  </section>
</SiteLayout>
